NODE_ENV=production
HOST=0.0.0.0
PORT=8080
TZ=Asia/Shanghai
PUBLIC_ORIGIN=https://x.example.com
# Set only when the backend is reached through a trusted reverse proxy.
TRUST_PROXY=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=game
MYSQL_USER=game
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
HEALTH_REDIS=1
# Inline secret OR the existing Yii JWT_KEY path. Use the same key to accept existing JWTs.
JWT_SECRET=
JWT_KEY=/run/secrets/jwt-key
ADMIN_USERNAME=dirui
# PHP $2y$ and bcrypt $2b$ hashes are supported. Set an explicit password hash.
ADMIN_PASSWORD_HASH=
ADMIN_SCAN_LOGIN_ORIGIN=https://x.example.com
# Keep these values and mounted EC P-256 keys identical across Yii and Node nodes.
ADMIN_AUTH_ISSUER=https://x.example.com
ADMIN_JWT_KEY=/var/www/.ssh/jwt-key.pem
ADMIN_JWT_PUB_KEY=/var/www/.ssh/jwt-key-pub.pem
# Empty values inherit the business Redis settings without changing its database.
ADMIN_AUTH_REDIS_HOST=
ADMIN_AUTH_REDIS_PORT=
ADMIN_AUTH_REDIS_DB=
ADMIN_AUTH_REDIS_PASSWORD=
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
# Protocol validation is enabled by default. Set 1 only in an isolated dev environment.
GAME_DEV_AUTH=0
SCENE_SERVER_BASE_URL=https://y1.b0.01xr.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat-merchant.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat-platform.pem
# Optional override; unset uses PUBLIC_ORIGIN or request origin + the legacy v1 path.
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=https://x.example.com/v2/wechat-pay/refund-notify
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-nanjing
